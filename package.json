{
  "name": "depver-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that tells AI coding agents which package versions really exist on npm, PyPI, pub.dev and Packagist",
  "license": "MIT",
  "type": "module",
  "bin": {
    "depver-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tweetgeek/depver-mcp.git"
  },
  "homepage": "https://github.com/tweetgeek/depver-mcp#readme",
  "bugs": {
    "url": "https://github.com/tweetgeek/depver-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "package-versions",
    "npm",
    "pypi",
    "pub.dev",
    "packagist",
    "ai-agents",
    "dependencies"
  ],
  "scripts": {
    "build": "tsup",
    "build:check": "node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "prettier": "3.9.10",
    "semver": "7.8.6",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
